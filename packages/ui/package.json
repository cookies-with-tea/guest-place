	"devDependencies": {
		"@admin-panel/eslint-config": "workspace:*",
		"@admin-panel/typescript-config": "workspace:*",
		"@pivanov/vite-plugin-svg-sprite": "^3.1.5",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vitest/coverage-v8": "^3.2.4",
		"vite": "^7.1.7",
		"vite-svg-sprite-wrapper": "^1.5.0",
