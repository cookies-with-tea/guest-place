{
	"name": "@admin-panel/lib",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "pnpm unbuild --stub",
		"prepublishOnly": "npm run build",
		"prepack": "pnpm unbuild",
		"build": "unbuild --entries ./src/index --declaration --outDir dist",
		"lint": "eslint ."
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.ts"
		},
		"./api": {
			"require": "./dist/api.cjs",
			"import": "./dist/api.mjs",
			"types": "./dist/api.d.ts"
		},
		"./constants": {
			"require": "./dist/constants.cjs",
			"import": "./dist/constants.mjs",
			"types": "./dist/constants.d.ts"
		},
		"./model": {
			"require": "./dist/model.cjs",
			"import": "./dist/model.mjs",
			"types": "./dist/model.d.ts"
		},
		"./utils": {
			"require": "./dist/utils.cjs",
			"import": "./dist/utils.mjs",
			"types": "./dist/utils.d.ts"
		},
		"./vite": {
			"require": "./dist/vite.cjs",
			"import": "./dist/vite.mjs",
			"types": "./dist/vite.d.ts"
		}
	},
	"devDependencies": {
		"@admin-panel/eslint-config": "workspace:*",
		"@admin-panel/typescript-config": "workspace:*",
		"@types/node": "^24.9.2",
		"typescript": "^5.9.3",
		"unbuild": "^3.6.1"
	},
	"dependencies": {
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"defu": "^6.1.4",
		"element-plus": "^2.13.0",
		"ofetch": "^1.3.4",
		"vite": "^7.1.7"
	}
}
