{
  "name": "client",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "eslint": "eslint . --ext .ts,.js,.vue",
    "eslint:fix": "eslint . --ext .ts,.js,.vue --fix",
    "stylelint": "stylelint \"**/*.{vue,css,scss,postcss}\"",
    "stylelint:fix": "stylelint \"**/*.{vue,css,scss,postcss}\" --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint": "pnpm eslint && pnpm stylelint && pnpm prettier",
    "lint:fix": "pnpm eslint:fix && pnpm stylelint:fix && pnpm prettier:fix",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/eslint": "1.9.0",
    "@nuxt/image": "1.11.0",
    "@nuxtjs/stylelint-module": "5.2.1",
    "async-validator": "^4.2.5",
    "gsap": "^3.13.0",
    "nuxt": "^4.1.3",
    "nuxt-svgo": "4.2.6",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.21.0",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/parser": "^8.46.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.5",
    "playwright-core": "^1.57.0",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "3.6.2",
    "sass": "^1.93.2",
    "stylelint": "^16.25.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "typed-icon-template": "^0.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^10.2.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint . --ext .ts,.js,.vue"
    ],
    "*.{css,scss,postcss,vue}": [
      "stylelint \"**/*.{vue,css,scss,postcss}\""
    ],
    "*": [
      "prettier --check ."
    ]
  }
}
