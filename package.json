{
	"name": "admin-panel",
	"description": "Admin Panel",
	"version": "1.0.0",
	"author": "miirsery",
	"dependencies": {
		"@vueuse/core": "^14.2.1",
		"vue": "^3.5.22",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@admin-panel/eslint-config": "workspace:*",
		"@admin-panel/prettier-config": "workspace:*",
		"@admin-panel/stylelint-config": "workspace:*",
		"@admin-panel/typescript-config": "workspace:*",
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.9.2",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/test-utils": "^2.4.6",
		"cypress": "^15.3.0",
		"dependency-cruiser": "^15.0.0",
		"enquirer": "^2.4.1",
		"eslint": "^9.38.0",
		"eslint-plugin-security": "^3.0.1",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"husky": "^9.1.7",
		"jiti": "^2.5.1",
		"jsdom": "^27.0.0",
		"lint-staged": "^16.2.5",
		"npm-run-all2": "^8.0.4",
		"prettier": "3.6.2",
		"sass": "^1.93.2",
		"start-server-and-test": "^2.1.2",
		"stylelint": "^16.25.0",
		"syncpack": "^14.3.0",
		"turbo": "latest",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vite-plugin-vue-devtools": "^8.0.2",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.1.0"
	},
	"keywords": [],
	"lint-staged": {
		"*.{js,ts,vue}": [
			"eslint --fix",
			"vitest related --run --passWithNoTests"
		],
		"*.{css,scss,postcss,vue}": [
			"stylelint --fix"
		],
		"*": [
			"prettier --write --ignore-unknown"
		]
	},
	"packageManager": "pnpm@9.0.6",
	"private": true,
	"scripts": {
		"build": "turbo run build --filter=\"admin-*\" --filter=\"@admin-panel/*\" --filter=!admin-panel",
		"build-only": "vite build",
		"build:mf": "turbo run build --filter=\"admin-*\" --filter=\"@admin-panel/ui\" --filter=!admin-panel",
		"build:packages": "turbo run build --filter=\"@admin-panel/*\"",
		"build:project": "node scripts/choose-project.js build",
		"clean": "turbo run clean && rm -rf node_modules",
		"clean:project": "node scripts/choose-project.js clean",
		"create:mf": "node scripts/create-mf/index.js",
		"dev": "pnpm build:packages && turbo run dev --parallel --filter=\"admin-*\" --filter=\"@admin-panel/*\" --filter=!admin-panel",
		"dev:all": "pnpm build && run-p \"preview:mf\" \"dev:shell\"",
		"dev:fast": "turbo run dev --parallel --filter=\"admin-*\" --filter=\"@admin-panel/*\" --filter=!admin-docs --filter=!admin-panel",
		"dev:project": "pnpm build:packages && node scripts/choose-project.js dev",
		"dev:shell": "turbo run dev --filter=\"admin-shell\"",
		"eslint": "eslint . --cache",
		"eslint:fix": "eslint . --fix --cache",
		"format": "prettier --write src/",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"lint:project": "node scripts/choose-project.js lint",
		"prebuild": "pnpm --filter @admin-panel/lib build",
		"prepare": "husky",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"preview": "turbo run preview --parallel --filter=\"admin-*\" --filter=!admin-panel && turbo run dev --filter=\"admin-shell\"",
		"preview:project": "pnpm build:packages && node scripts/choose-project.js preview",
		"preview-storybook": "turbo run preview-storybook",
		"preview:mf": "pnpm prebuild && turbo run preview --parallel --filter=\"admin-*\" --filter=!admin-shell --filter=!admin-docs --filter=!admin-panel",
		"storybook": "turbo run storybook --filter=docs",
		"stylelint": "stylelint \"**/*.{vue,css,scss,postcss}\" --cache",
		"stylelint:fix": "stylelint \"**/*.{vue,css,scss,postcss}\" --fix --cache",
		"syncpack:format": "syncpack format",
		"syncpack:lint": "syncpack lint",
		"test": "pnpm test:unit",
		"test:changes": "vitest --changed",
		"test:coverage": "turbo run test:coverage --parallel",
		"test:unit": "turbo run test:unit --parallel",
		"type-check": "vue-tsc --build"
	},
	"type": "module"
}
