{
	"name": "admin-panel",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"description": "Admin Panel",
	"keywords": [],
	"author": "miirsery",
	"scripts": {
		"prebuild": "pnpm --filter @admin-panel/lib build",
		"build": "turbo run build --filter=!./apps/admin-docs",
		"build:project": "node scripts/choose-project.js build",
		"dev:project": "node scripts/choose-project.js dev",
		"lint:project": "node scripts/choose-project.js lint",
		"clean:project": "node scripts/choose-project.js clean",
		"create:mf": "node scripts/create-mf.js",
		"dev": "turbo run dev --parallel",
		"preview": "turbo run preview --parallel && turbo run dev --filter=./apps/admin-shell",
		"dev:shell": "turbo run dev --filter=./apps/admin-shell",
		"preview:mf": "pnpm prebuild && turbo run preview --parallel --filter=./apps/* --filter=!./apps/admin-shell --filter=!./apps/admin-docs",
		"dev:all": "run-p \"preview:mf\" \"dev:shell\"",
		"clean": "turbo run clean && rm -rf node_modules",
		"test": "pnpm test:unit",
		"test:unit": "turbo run test:unit --parallel",
		"e2e:statistics": "pnpm -C apps/admin-statistics test:e2e",
		"e2e:translations": "pnpm -C apps/admin-translations test:e2e",
		"e2e:dev:statistics": "pnpm -C apps/admin-statistics test:e2e:dev",
		"e2e:dev:translations": "pnpm -C apps/admin-translations test:e2e:dev",
		"test:e2e": "run-s e2e:statistics e2e:translations",
		"test:e2e:dev": "run-s e2e:dev:statistics e2e:dev:translations",
		"prepare": "husky",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"format": "prettier --write src/",
		"eslint": "eslint . --ext .ts,.js,.vue",
		"eslint:fix": "eslint . --ext .ts,.js,.vue --fix",
		"stylelint": "stylelint \"**/*.{vue,css,scss,postcss}\"",
		"stylelint:fix": "stylelint \"**/*.{vue,css,scss,postcss}\" --fix",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"lint": "pnpm eslint && pnpm stylelint && pnpm prettier",
		"lint:fix": "pnpm eslint:fix && pnpm stylelint:fix && pnpm prettier:fix",
		"storybook": "turbo run storybook --filter=docs",
		"preview-storybook": "turbo run preview-storybook",
		"build:mf": "turbo run build --filter=./apps/* --filter=./packages/ui",
		"dev:fast": "turbo run dev --parallel --filter=!./apps/admin-docs",
		"why": "pnpm why",
		"outdated": "pnpm outdated",
		"dedupe": "pnpm dedupe"
	},
	"dependencies": {
		"vue": "^3.5.22",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@admin-panel/eslint-config": "workspace:*",
		"@admin-panel/prettier-config": "workspace:*",
		"@admin-panel/stylelint-config": "workspace:*",
		"@admin-panel/typescript-config": "workspace:*",
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.9.2",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/test-utils": "^2.4.6",
		"cypress": "^15.3.0",
		"dependency-cruiser": "^15.0.0",
		"enquirer": "^2.4.1",
		"eslint": "^9.38.0",
		"eslint-plugin-security": "^3.0.1",
		"husky": "^9.1.7",
		"jiti": "^2.5.1",
		"jsdom": "^27.0.0",
		"lint-staged": "^16.2.5",
		"npm-run-all2": "^8.0.4",
		"prettier": "3.6.2",
		"sass": "^1.93.2",
		"start-server-and-test": "^2.1.2",
		"stylelint": "^16.25.0",
		"turbo": "latest",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vite-plugin-vue-devtools": "^8.0.2",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.1.0"
	},
	"lint-staged": {
		"*.{js,ts,vue}": [
			"eslint . --ext .ts,.js,.vue"
		],
		"*.{css,scss,postcss,vue}": [
			"stylelint \"**/*.{vue,css,scss,postcss}\""
		],
		"*": [
			"prettier --check ."
		]
	},
	"packageManager": "pnpm@9.0.6"
}
