{
	"name": "admin-panel",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"description": "Admin Panel",
	"keywords": [],
	"author": "miirsery",
	"scripts": {
		"build": "turbo run build",
		"build:project": "node scripts/choose-project.js",
		"dev": "turbo run dev --parallel",
		"test": "vitest",
		"clean": "turbo run clean && rm -rf node_modules",
		"test:unit": "vitest",
		"prepare": "husky",
		"test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
		"test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"format": "prettier --write src/",
		"eslint": "eslint . --ext .ts,.js,.vue",
		"eslint:fix": "eslint . --ext .ts,.js,.vue --fix",
		"stylelint": "stylelint \"**/*.{vue,css,scss,postcss}\"",
		"stylelint:fix": "stylelint \"**/*.{vue,css,scss,postcss}\" --fix",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"lint": "pnpm eslint && pnpm stylelint && pnpm prettier",
		"lint:fix": "pnpm eslint:fix && pnpm stylelint:fix && pnpm prettier:fix"
	},
	"dependencies": {
		"vue": "^3.5.22",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@admin-panel/eslint-config": "workspace:*",
		"@admin-panel/prettier-config": "workspace:*",
		"@admin-panel/stylelint-config": "workspace:*",
		"@admin-panel/typescript-config": "workspace:*",
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.9.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/test-utils": "^2.4.6",
		"cypress": "^15.3.0",
		"enquirer": "^2.4.1",
		"eslint": "^9.38.0",
		"husky": "^9.1.7",
		"jiti": "^2.5.1",
		"jsdom": "^27.0.0",
		"lint-staged": "^16.2.5",
		"npm-run-all2": "^8.0.4",
		"prettier": "3.6.2",
		"sass": "^1.93.2",
		"start-server-and-test": "^2.1.2",
		"stylelint": "^16.25.0",
		"turbo": "latest",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vite-plugin-vue-devtools": "^8.0.2",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.1.0"
	},
	"lint-staged": {
		"*.{js,ts,vue}": [
			"eslint --fix"
		],
		"*.{css,scss,postcss,vue}": [
			"stylelint --fix"
		],
		"*": [
			"prettier --write --ignore-unknown"
		]
	},
	"packageManager": "pnpm@9.0.6"
}
