{
	"name": "admin-panel-shell",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite",
    "build": "tsc && vite build",
		"preview": "vite preview",
		"test:unit": "vitest",
		"prepare": "husky",
		"test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
		"test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"format": "prettier --write src/",
		"eslint": "eslint . --ext .ts,.js,.vue",
		"eslint:fix": "eslint . --ext .ts,.js,.vue --fix",
		"stylelint": "stylelint \"**/*.{vue,css,scss,postcss}\"",
		"stylelint:fix": "stylelint \"**/*.{vue,css,scss,postcss}\" --fix",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"lint": "pnpm eslint && pnpm stylelint && pnpm prettier",
		"lint:fix": "pnpm eslint:fix && pnpm stylelint:fix && pnpm prettier:fix"
	},
	"dependencies": {
		"vue": "^3.5.22",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@tsconfig/node22": "^22.0.2",
		"@types/jsdom": "^21.1.7",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vitest/eslint-plugin": "^1.3.13",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.6.0",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.8.1",
		"cypress": "^15.3.0",
		"eslint-plugin-cypress": "^5.1.1",
		"eslint-plugin-vue": "~10.4.0",
		"jiti": "^2.5.1",
		"jsdom": "^27.0.0",
		"npm-run-all2": "^8.0.4",
		"start-server-and-test": "^2.1.2",
		"vite": "^7.1.7",
		"vite-plugin-vue-devtools": "^8.0.2",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.1.0",
		"@stylistic/stylelint-plugin": "^4.0.0",
		"@types/node": "^24.9.1",
		"@typescript-eslint/parser": "^8.46.2",
		"eslint": "^9.38.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.5",
		"postcss-html": "^1.8.0",
		"postcss-scss": "^4.0.9",
		"prettier": "3.6.2",
		"sass": "^1.93.2",
		"stylelint": "^16.25.0",
		"stylelint-config-prettier": "^9.0.5",
		"stylelint-config-recess-order": "^7.4.0",
		"stylelint-config-recommended-vue": "^1.6.1",
		"stylelint-config-standard-scss": "^16.0.0",
		"stylelint-order": "^7.0.0",
		"stylelint-scss": "^6.12.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vue-eslint-parser": "^10.2.0"
	},
	"lint-staged": {
		"*.{js,ts,vue}": [
			"eslint --fix"
		],
		"*.{css,scss,postcss,vue}": [
			"stylelint --fix"
		],
		"*": [
			"prettier --write --ignore-unknown"
		]
	}
}
