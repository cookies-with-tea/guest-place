{
	"extends": "@admin-panel/typescript-config",
	"compilerOptions": {
		"composite": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"#app/*": ["./src/app/*"],
			"#pages/*": ["./src/pages/*"],
			"#widgets/*": ["./src/widgets/*"],
			"#features/*": ["./src/features/*"],
			"#entities/*": ["./src/entities/*"],
			"#shared/*": ["./src/shared/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
	"exclude": ["node_modules", "dist"]
}
