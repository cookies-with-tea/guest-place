{
	"name": "admin-translations",
	"version": "0.0.0",
	"dependencies": {
		"@admin-panel/i18n": "workspace:*",
		"@admin-panel/lib": "workspace:*",
		"@admin-panel/ui": "workspace:*",
		"@tanstack/vue-query": "^5.92.1",
		"element-plus": "^2.13.0",
		"pinia": "^2.1.7",
		"vue": "^3.5.22",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@admin-panel/stylelint-config": "workspace:*",
		"@admin-panel/typescript-config": "workspace:*",
		"@types/node": "^24.9.2",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vitest/coverage-v8": "^3.2.4",
		"npm-run-all2": "^8.0.4",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vue-tsc": "^3.1.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"lint": "run-p oxlint stylelint oxfmt:check",
		"lint:fix": "run-p oxlint:fix stylelint:fix oxfmt",
		"oxfmt": "oxfmt",
		"oxfmt:check": "oxfmt --check",
		"oxlint": "oxlint",
		"oxlint:fix": "oxlint --fix",
		"preview": "vite preview",
		"stylelint": "stylelint \"**/*.{vue,css,scss,postcss}\" --cache",
		"stylelint:fix": "stylelint \"**/*.{vue,css,scss,postcss}\" --fix --cache",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"test:e2e": "start-server-and-test 'vite dev' http://localhost:4175 'cypress run --e2e'",
		"test:e2e:dev": "start-server-and-test 'vite dev' http://localhost:4175 'cypress open --e2e'",
		"test:unit": "vitest --passWithNoTests",
		"type-check": "vue-tsc --build"
	},
	"type": "module"
}
