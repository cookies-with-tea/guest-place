{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "storybook-static/**"],
			"dependsOn": ["^build"]
		},
  	"lint": {
      "dependsOn": ["^lint"]
    },
		"dev": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"cache": false,
			"persistent": true
		},
	 "clean": {
      "cache": false
    },
    "preview-storybook": {
       "dependsOn": [
         "^build"
       ],
       "cache": false
     },
     "storybook": {
      "cache": false,
      "persistent": true
    }
	}
}
