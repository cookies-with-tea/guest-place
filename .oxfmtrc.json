{
	"semi": false,
	"tabWidth": 2,
	"printWidth": 120,
	"useTabs": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"bracketSameLine": false,
	"htmlWhitespaceSensitivity": "strict",
	"arrowParens": "always",
	"trailingComma": "es5",
	"proseWrap": "never",
	"endOfLine": "lf",
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/dist",
		"**/dist-ssr",
		"**/build",
		"**/coverage",
		"**/storybook-static",
		"**/node_modules",
		"stylelint_output.txt",
		"*.html",
		"pnpm-lock.yaml",
		"**/sprite/sprite.ts",
		"**/*.{png,jpg,jpeg,gif,webp,svg,ico,pdf,woff,woff2,ttf,eot}"
	]
}
